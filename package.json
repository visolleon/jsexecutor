{
  "name": "jsexecutor",
  "version": "1.0.0",
  "description": "Node.js code executor with HTTP API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "docker:build": "docker build -t visolleon/jsexecutor:latest .",
    "docker:push": "docker push visolleon/jsexecutor:latest",
    "docker:publish": "npm run docker:build && npm run docker:push",
    "docker:run": "docker compose up -d",
    "docker:stop": "docker compose down"
  },
  "dependencies": {
    "express": "^4.18.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "author": "",
  "license": "MIT"
}